# Server Configuration
PORT=3000

# Database
MONGOO_URL=mongodb://localhost:27017/ecommerce

# JWT Secret (IMPORTANT: Your code uses JWT_KEY not JWT_SECRET)
JWT_KEY=your_super_secret_jwt_key_here

# Cloudinary Configuration (IMPORTANT: Your code uses these exact names)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Stripe Configuration (IMPORTANT: Your code uses SECRET_KEY not STRIPE_SECRET_KEY)
SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration - Using Ethereal for testing
# Get free test account at https://ethereal.email/
ETHEREAL_USER=your_ethereal_user@ethereal.email
ETHEREAL_PASS=your_ethereal_password

# Frontend URL (for CORS and Stripe redirects)
FRONTEND_URL=http://localhost:3000
